<span class="logo">
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round">
    <circle cx="24" cy="24" r="21" stroke-width="1.5"/>
    <% for (let i = 0; i < 12; i++) {
         const a = (i * 30 * Math.PI) / 180;
         const major = i % 3 === 0;
         const r1 = major ? 15.6 : 17.4;
         const r2 = 19;
         const x1 = (24 + Math.sin(a) * r1).toFixed(2);
         const y1 = (24 - Math.cos(a) * r1).toFixed(2);
         const x2 = (24 + Math.sin(a) * r2).toFixed(2);
         const y2 = (24 - Math.cos(a) * r2).toFixed(2); %>
    <line x1="<%= x1 %>" y1="<%= y1 %>" x2="<%= x2 %>" y2="<%= y2 %>" stroke-width="<%= major ? 1.5 : 1 %>"/>
    <% } %>
    <path d="M24 24 17 19.2" stroke-width="2"/>
    <path d="M24 24 35.3 17.5" stroke-width="1.6"/>
    <circle cx="24" cy="24" r="1.8" fill="currentColor" stroke="none"/>
  </svg>
  <% if (!locals.markOnly) { %>
  <span class="logo__word"><%= site.brand.name %></span>
  <% if (locals.tagline) { %><span class="logo__tag"><%= site.brand.tagline %></span><% } %>
  <% } %>
</span>
